{
  "subject_column": "subject_id",
  "recording_column": "recording_id",
  "split_column": "split",
  "split_map": {
    "development_train": "train",
    "development": "val",
    "confirmation": "test"
  },
  "factors": {
    "order": [
      "speed",
      "clothing",
      "direction"
    ],
    "values": {
      "speed": [
        "UGS",
        "FGS"
      ],
      "clothing": [
        "WoJ",
        "WJ"
      ],
      "direction": [
        "R2L",
        "L2R"
      ]
    }
  },
  "recording_aggregation": {
    "windows_per_recording": 3,
    "method": "mean",
    "dtype": "float64"
  },
  "complete_case": {
    "required_cells": 8,
    "missing_cell": "exclude_participant",
    "duplicate_cell": "error"
  },
  "query": {
    "targets_per_participant": 8,
    "condition_donor": "same_clothing_direction_opposite_speed",
    "gait_donors": "same_speed_all_other_clothing_direction_pairs",
    "gait_donors_per_target": 3,
    "queries_per_participant": 24
  },
  "gallery": {
    "exclude_condition_donor": true,
    "exclude_gait_donor": true,
    "size": 6,
    "target_count": 1,
    "distractor_count": 5
  },
  "distance": {
    "metric": "cosine",
    "condition_weight": 0.5,
    "gait_weight": 0.5,
    "dtype": "float64",
    "zero_norm_epsilon": 1e-12
  },
  "ties": {
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 0.0,
    "rank": "average_occupied_rank",
    "top1": "fractional_credit"
  },
  "adapter": {
    "type": "ridge",
    "alpha": 1.0,
    "fit_split": "development_train",
    "input_standardization": "population",
    "condition_labels": [
      "WoJ",
      "WJ",
      "R2L",
      "L2R"
    ],
    "gait_labels": [
      "UGS",
      "FGS"
    ],
    "condition_output_dim": 4,
    "gait_output_dim": 2
  },
  "normalization": {
    "fit_split": "development_train",
    "primary": "raw_retain_all",
    "sensitivities": [
      "raw_effective_rank",
      "pca_effective_rank"
    ],
    "standardization": "population",
    "scale_floor": 1e-12,
    "block_l2_epsilon": 1e-12,
    "effective_rank_rounding": "nearest_half_up",
    "pca_solver": "full_svd"
  },
  "shortcut": {
    "condition_columns": [
      "shortcut_horizontal_centroid_drift_signed",
      "shortcut_horizontal_centroid_drift_absolute",
      "shortcut_foreground_area_mean",
      "shortcut_foreground_area_std",
      "shortcut_foreground_area_q25",
      "shortcut_foreground_area_median",
      "shortcut_foreground_area_q75"
    ],
    "gait_columns": [
      "shortcut_log_frame_count",
      "shortcut_duration_seconds"
    ]
  },
  "metrics": [
    "top1",
    "mean_reciprocal_rank",
    "donor_attraction"
  ],
  "primary_metric": "top1",
  "primary_contrast": "learned_minus_shortcut",
  "bootstrap": {
    "unit": "participant",
    "resamples": 10000,
    "seed": 20260728,
    "confidence_level": 0.95,
    "interval": "percentile"
  },
  "power": {
    "effect": 0.041666666666666664,
    "alpha": 0.05,
    "minimum_power": 0.8,
    "alternative": "two_sided",
    "participant_standard_deviation_ddof": 1
  }
}
