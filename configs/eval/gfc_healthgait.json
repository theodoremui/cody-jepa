{
  "subject_column": "subject_id",
  "recording_column": "recording_id",
  "split_column": "split",
  "split_map": {
    "development_train": "train",
    "development": "val",
    "confirmation": "test"
  },
  "factors": {
    "order": [
      "speed",
      "clothing",
      "direction"
    ],
    "values": {
      "speed": [
        "UGS",
        "FGS"
      ],
      "clothing": [
        "WoJ",
        "WJ"
      ],
      "direction": [
        "R2L",
        "L2R"
      ]
    }
  },
  "recording_aggregation": {
    "windows_per_recording": 3,
    "method": "mean",
    "dtype": "float64"
  },
  "complete_case": {
    "missing_cell": "exclude_participant",
    "duplicate_cell": "error"
  },
  "protocol": {
    "name": "gfc_v2",
    "donor_rule": "binary_complementary_two_donor",
    "focal_factors": [
      "speed",
      "clothing"
    ],
    "gallery_policy": "retain_all",
    "require_target_source_independence": true
  },
  "distance": {
    "metric": "cosine",
    "factor_aggregation": "equal_mean",
    "dtype": "float64",
    "zero_norm_epsilon": 1e-12
  },
  "ties": {
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 0.0,
    "rank": "average_occupied_rank",
    "top1": "fractional_credit"
  },
  "adapter": {
    "type": "ridge",
    "alpha": 1.0,
    "fit_split": "development_train",
    "input_standardization": "population",
    "factor_names": [
      "speed",
      "clothing",
      "direction"
    ],
    "factor_labels": {
      "speed": [
        "UGS",
        "FGS"
      ],
      "clothing": [
        "WoJ",
        "WJ"
      ],
      "direction": [
        "R2L",
        "L2R"
      ]
    }
  },
  "normalization": {
    "fit_split": "development_train",
    "primary": "raw_retain_all",
    "sensitivities": [
      "raw_effective_rank",
      "pca_effective_rank"
    ],
    "standardization": "population",
    "scale_floor": 1e-12,
    "block_l2_epsilon": 1e-12,
    "effective_rank_rounding": "nearest_half_up",
    "pca_solver": "full_svd"
  },
  "shortcut": {
    "columns": [
      "shortcut_horizontal_centroid_drift_signed",
      "shortcut_horizontal_centroid_drift_absolute",
      "shortcut_foreground_area_mean",
      "shortcut_foreground_area_std",
      "shortcut_foreground_area_q25",
      "shortcut_foreground_area_median",
      "shortcut_foreground_area_q75",
      "shortcut_log_frame_count",
      "shortcut_duration_seconds"
    ]
  },
  "metrics": [
    "top1",
    "mean_reciprocal_rank",
    "donor_u_attraction",
    "donor_v_attraction"
  ],
  "primary_metric": "top1",
  "primary_contrast": "learned_minus_shortcut",
  "bootstrap": {
    "unit": "participant",
    "resamples": 10000,
    "seed": 20260728,
    "confidence_level": 0.95,
    "interval": "percentile"
  },
  "power": {
    "effect": 0.0625,
    "alpha": 0.05,
    "minimum_power": 0.8,
    "alternative": "two_sided",
    "participant_standard_deviation_ddof": 1
  }
}
